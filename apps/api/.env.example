# Copy to apps/api/.env for local development (never commit .env).
# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://kalo:change-me@localhost:5432/kalo
# Exact origin the browser uses (scheme + host + port, no trailing slash). Writes from any other origin are rejected.
PUBLIC_ORIGIN=http://localhost:5173
# better-auth (default, production) or dev (local only: anyone signs in as a shared user).
KALO_AUTH=dev
# Optional
# PORT=8080
# DATABASE_MAX_CONNECTIONS=10
# RUN_MIGRATIONS=true
# BETTER_AUTH_COOKIE=__Secure-better-auth.session_token
# STATIC_DIR=../web/dist
RUST_LOG=info
